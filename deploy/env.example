# Sunucuda /opt/em3task/.env olarak kopyalanır ve doldurulur (chmod 600).
# Supabase adresi ve anahtarları: Supabase → Project Settings → API Keys.
# VAPID anahtarları ve CRON_SECRET yeniden üretilmez; mevcut .env yedeğinden alınır
# (VAPID değişirse tüm bildirim abonelikleri, CRON_SECRET değişirse hatırlatma bozulur).
# Bu örnek dosyaya gerçek değer yazmayın.

# Herkese açık (imaja derlemede de gömülü; sunucu kodu da okur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Gizli
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Supabase Vault'taki em3task_cron_secret ile aynı olmalı (hatırlatma isteği bununla doğrulanır)
CRON_SECRET=
